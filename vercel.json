{
  "crons": [
    {
      "path": "/api/reset-monthly-usage",
      "schedule": "0 1 1 * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self' https://*.bizprotools360.com https://*.google.com;"
        }
      ]
    }
  ]
}
